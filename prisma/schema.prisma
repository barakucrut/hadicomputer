datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 0. MULTI-TENANT SAAS ARCHITECTURE
// ----------------------------------------------------
enum TenantPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
}

/// Etalase: DEMO = terkunci (hanya lewat link demo berkunci / tim internal), LIVE = publik.
enum TenantSiteStatus {
  DEMO
  LIVE
}

/// Peran akun internal platform (god-mode). SUPERADMIN = akses penuh, MARKETING = hanya tenant yang dibawanya.
enum PlatformRole {
  SUPERADMIN
  CMO
  MARKETING
}

/// Akun tim internal rigspace.id (bukan admin toko).
model PlatformUser {
  id              String       @id @default(cuid())
  email           String       @unique @db.VarChar(191)
  name            String       @db.VarChar(150)
  phone           String?      @db.VarChar(30)
  passwordHash    String       @db.VarChar(255)
  role            PlatformRole @default(MARKETING)
  isActive        Boolean      @default(true)
  lastLoginAt     DateTime?
  acquiredTenants Tenant[]     @relation("TenantAcquiredBy")
  /// Atasan (CMO) untuk akun MARKETING — dasar komisi override & lingkup tim CMO
  managerId       String?      @db.VarChar(191)
  manager         PlatformUser?  @relation("PlatformTeam", fields: [managerId], references: [id], onDelete: SetNull)
  reports         PlatformUser[] @relation("PlatformTeam")
  demoRequests    DemoRequest[]  @relation("DemoRequestAssignee")

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([managerId])
  @@map("platform_users")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  SUBSCRIPTION
  SETUP_FEE
  ADDON
  JUAL_PUTUS
  SERVER_INFRA
  DOMAIN_REGISTRATION
  WHATSAPP_GATEWAY
  MARKETING
  OPERATIONAL
  OTHER
}

model PlatformTransaction {
  id            String              @id @default(cuid())
  type          TransactionType     // INCOME or EXPENSE
  category      TransactionCategory // SUBSCRIPTION, SERVER_INFRA, etc.
  title         String              @db.VarChar(200)
  amount        Float
  status        String              @default("SUCCESS") // SUCCESS, PENDING, FAILED
  date          DateTime            @default(now())
  description   String?             @db.Text
  tenantId      String?             @db.VarChar(40)
  tenantName    String?             @db.VarChar(150)
  paymentMethod String?             @db.VarChar(50)
  receiptUrl    String?             @db.VarChar(255)

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId])
  @@index([type])
  @@index([date])
  @@map("platform_transactions")
}

model Tenant {
  id           String         @id @db.VarChar(40) // 40-char SHA-1 hex ID
  slug         String         @unique @db.VarChar(100)
  name         String         @db.VarChar(150)
  customDomain String?        @unique @db.VarChar(191)
  plan         TenantPlan     @default(PRO)
  status       TenantStatus   @default(ACTIVE)
  features     Json?          // { "pcBuilder": true, "tradeIn": true, "instantCheckout": false }
  // Marketing yang membawa tenant ini (null = dikelola langsung superadmin)
  acquiredById String?        @db.VarChar(191)
  acquiredBy   PlatformUser?  @relation("TenantAcquiredBy", fields: [acquiredById], references: [id], onDelete: SetNull)

  // Mode Demo: etalase terkunci sampai closing (lihat src/lib/demo-access.ts)
  siteStatus         TenantSiteStatus @default(LIVE)
  demoToken          String?          @unique @db.VarChar(64)
  demoTokenExpiresAt DateTime?
  liveAt             DateTime?
  demoViews          DemoView[]

  settings     TenantSetting?
  adminUsers   AdminUser[]
  roles        AdminRole[]
  products     Product[]
  categories   Category[]
  brands       Brand[]
  banners      Banner[]
  services     Service[]
  needs        ProductNeed[]
  inquiryLogs  InquiryLog[]
  serviceCases ServiceCase[]
  testimonials Testimonial[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([acquiredById])
  @@map("tenants")
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  REJECTED
}

/// Permintaan demo dari landing page rigspace.id — otomatis ditugaskan ke CMO aktif.
model DemoRequest {
  id           String            @id @default(cuid())
  storeName    String            @db.VarChar(150)
  city         String            @db.VarChar(100)
  whatsapp     String            @db.VarChar(20)
  storeLink    String?           @db.VarChar(300)
  status       DemoRequestStatus @default(NEW)
  assignedToId String?           @db.VarChar(191)
  assignedTo   PlatformUser?     @relation("DemoRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  note         String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([assignedToId, status])
  @@index([createdAt])
  @@map("demo_requests")
}

/// Catatan link demo dibuka calon klien (sinyal follow-up untuk marketing). Tanpa IP/data pribadi.
model DemoView {
  id        String   @id @default(cuid())
  tenantId  String   @db.VarChar(40)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device    String   @default("desktop") @db.VarChar(20)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("demo_views")
}

model TenantSetting {
  id                      String   @id @default(cuid())
  tenantId                String   @unique @db.VarChar(40)
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Branding
  tagline                 String?  @db.VarChar(200)
  logoUrl                 String?  @db.VarChar(255)
  faviconUrl              String?  @db.VarChar(255)
  primaryColor            String   @default("#cc252b") @db.VarChar(20)
  secondaryColor          String   @default("#111413") @db.VarChar(20)
  fontFamily              String   @default("Plus Jakarta Sans") @db.VarChar(50)
  
  // Custom Homepage Wording & Section Toggles
  homepageConfig          Json?    // { "featuredTitle": "...", "sections": { "heroSlider": true, ... } }
  
  // Kontak & Lokasi
  whatsappNumber          String   @default("6285769000007") @db.VarChar(30)
  whatsappDefaultTemplate String?  @db.Text
  address                 String?  @db.Text
  mapsEmbedUrl            String?  @db.Text
  mapsUrl                 String?  @db.VarChar(255)
  // Link "Lihat semua ulasan di Google" di bawah section testimoni (opsional)
  googleReviewUrl         String?  @db.VarChar(500)
  openHours               String   @default("Buka setiap hari: 08.00 – 22.00 WIB") @db.VarChar(200)
  
  // Media Sosial
  socialInstagram         String?  @db.VarChar(100)
  socialTiktok            String?  @db.VarChar(100)
  socialFacebook          String?  @db.VarChar(100)
  socialYoutube           String?  @db.VarChar(100)

  // SEO (kosong = otomatis dari nama & tagline toko)
  seoTitle                String?  @db.VarChar(70)
  seoDescription          String?  @db.VarChar(170)
  seoKeywords             String?  @db.VarChar(255)
  ogImageUrl              String?  @db.VarChar(255)
  googleSiteVerification  String?  @db.VarChar(120)
  // false = toko meminta tidak diindeks mesin pencari
  searchIndexing          Boolean  @default(true)

  // Analitik milik toko (opsional; GA platform RigSpace dipasang terpisah lewat env)
  gaMeasurementId         String?  @db.VarChar(20)
  gtmContainerId          String?  @db.VarChar(20)

  // Profil toko untuk storefront
  foundedYear             Int?
  // Chip pencarian cepat di bawah bar cari, mis. ["Laptop kuliah 5-8 jt", ...]
  quickSearches           Json?

  // Tampilan stok di etalase: hidden | exact | limited
  stockDisplay            String   @default("hidden") @db.VarChar(10)
  lowStockThreshold       Int      @default(3)

  // Kode SKU produk, mis. "HC" -> HC-0001 (null = otomatis dari nama toko)
  skuPrefix               String?  @db.VarChar(10)

  // Pengumuman
  announcementText        String?  @db.VarChar(255)
  isAnnouncementActive    Boolean  @default(false)

  updatedAt               DateTime @updatedAt

  @@map("tenant_settings")
}

// ----------------------------------------------------
// 1. AUTENTIKASI ADMIN & USER ROLE
// ----------------------------------------------------
model AdminRole {
  id          String      @id @default(cuid())
  // null = role sistem bawaan (dipakai bersama semua tenant, read-only)
  tenantId    String?     @db.VarChar(40)
  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String      @db.VarChar(100)
  slug        String      @db.VarChar(100)
  description String?     @db.VarChar(255)
  permissions Json        // Array string of permission keys: ["*"] or ["products:view", ...]
  isSystem    Boolean     @default(false)
  users       AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("admin_roles")
}

model AdminUser {
  id           String      @id @default(cuid())
  email        String      @unique @db.VarChar(191)
  passwordHash String      @db.VarChar(255)
  name         String      @db.VarChar(100)
  role         String      @default("OWNER") @db.VarChar(30)
  roleId       String?
  roleRef      AdminRole?  @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true)
  tenantId     String?     @db.VarChar(40)
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId])
  @@index([roleId])
  @@map("admin_users")
}

// ----------------------------------------------------
// 2. KATEGORI & MEREK
// ----------------------------------------------------
model Category {
  id          String    @id @default(cuid())
  tenantId    String?   @db.VarChar(40)
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(100)
  icon        String?   @db.VarChar(50)
  description String?   @db.Text
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  tenantId  String?   @db.VarChar(40)
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(100)
  slug      String    @db.VarChar(100)
  logoUrl   String?   @db.VarChar(255)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("brands")
}

model ProductNeed {
  id          String   @id @default(cuid())
  tenantId    String?  @db.VarChar(40)
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("product_needs")
}

// ----------------------------------------------------
// 3. PRODUK & DETAIL KATALOG
// ----------------------------------------------------
enum ProductCondition {
  BARU
  BEKAS
}

enum AvailabilityStatus {
  TERSEDIA
  PREORDER
  HABIS
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id                String             @id @default(cuid())
  tenantId          String?            @db.VarChar(40)
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code              String             @db.VarChar(50)
  slug              String             @db.VarChar(150)
  name              String             @db.VarChar(200)
  summary           String             @db.VarChar(255)
  description       String             @db.Text
  condition         ProductCondition   @default(BARU)
  basePrice         BigInt?            // null = Hubungi Owner untuk Harga
  originalPrice     BigInt?            // Harga coret untuk diskon/hemat
  availability      AvailabilityStatus @default(TERSEDIA)
  // Jumlah stok (null = stok tidak dilacak). Stok 0 otomatis membuat produk HABIS.
  stock             Int?
  warranty          String             @default("Garansi Toko 1 Bulan") @db.VarChar(100)
  bonus             String?            @db.VarChar(255)
  
  // Tagging & Kurasi Tampilan Beranda
  isFeatured        Boolean            @default(false)
  isBestSeller      Boolean            @default(false)
  isPromo           Boolean            @default(false)
  isNewArrival      Boolean            @default(false)
  needs             Json?
  
  // Status Publikasi
  publicationStatus PublicationStatus  @default(PUBLISHED)
  
  // Relasi
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id])
  brandId           String
  brand             Brand              @relation(fields: [brandId], references: [id])
  
  variants          ProductVariant[]
  images            ProductImage[]
  specs             ProductSpec[]
  inquiryLogs       InquiryLog[]
  banners           Banner[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // Soft delete: terisi = produk sudah dihapus (data & SKU tetap tersimpan)
  deletedAt         DateTime?
  // true = data contoh Starter Pack (bisa dihapus massal oleh toko)
  isSample  Boolean  @default(false)

  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
  @@index([brandId])
  @@index([publicationStatus, availability])
  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  id            String             @id @default(cuid())
  productId     String
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String             @db.VarChar(100)
  price         BigInt?
  originalPrice BigInt?
  availability  AvailabilityStatus @default(TERSEDIA)
  isDefault     Boolean            @default(false)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(255)
  altText   String?  @db.VarChar(150)
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductSpec {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String   @db.VarChar(100)
  value     String   @db.VarChar(255)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_specs")
}

// ----------------------------------------------------
// 4. BANNER HERO & INTERACTIVE HOTSPOTS
// ----------------------------------------------------
model Banner {
  id        String          @id @default(cuid())
  tenantId  String?         @db.VarChar(40)
  tenant    Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String          @db.VarChar(150)
  subtitle  String?         @db.VarChar(255)
  badgeText String?         @db.VarChar(100)
  ctaLabel  String?         @db.VarChar(50)
  ctaUrl    String?         @db.VarChar(255)
  // Kosong = memakai foto produk yang ditautkan
  imageUrl  String?         @db.VarChar(255)
  imageAlt  String          @db.VarChar(150)
  bgTheme   String          @default("dark") @db.VarChar(20)
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  hotspots  BannerHotspot[]
  // Posisi di hero template: "hero" (banner utama, slide) | "tile" (kartu samping)
  placement String          @default("hero") @db.VarChar(10)
  // Produk tertaut: harga, harga coret, spek & link otomatis dari produk
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Harga manual untuk banner tanpa produk (opsional)
  price         BigInt?
  originalPrice BigInt?
  // true = data contoh Starter Pack (bisa dihapus massal oleh toko)
  isSample  Boolean  @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([tenantId])
  @@index([productId])
  @@map("banners")
}

model BannerHotspot {
  id        String   @id @default(cuid())
  bannerId  String
  banner    Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  label     String   @db.VarChar(100)
  xPercent  Float
  yPercent  Float
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([bannerId])
  @@map("banner_hotspots")
}

// ----------------------------------------------------
// 5. LAYANAN & SERVIS
// ----------------------------------------------------
model Service {
  id                 String       @id @default(cuid())
  tenantId           String?      @db.VarChar(40)
  tenant             Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title              String       @db.VarChar(150)
  slug               String       @db.VarChar(150)
  summary            String       @db.VarChar(255)
  description        String       @db.Text
  estimatedTime      String       @db.VarChar(100)
  priceInfo          String       @db.VarChar(100)
  ctaWhatsappText    String       @db.VarChar(255)
  iconName           String?      @db.VarChar(50)
  imageUrl           String?      @db.VarChar(255)
  isActive           Boolean      @default(true)
  sortOrder          Int          @default(0)
  inquiryLogs        InquiryLog[]
  cases              ServiceCase[]
  // true = data contoh Starter Pack (bisa dihapus massal oleh toko)
  isSample  Boolean  @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("services")
}

// ----------------------------------------------------
// 6. PENGATURAN TOKO (SINGLETON RECORD)
// ----------------------------------------------------
model StoreSetting {
  id                         String   @id @default("default")
  storeName                  String   @default("Hadi Computer") @db.VarChar(100)
  tagline                    String   @default("Pusat Laptop & Komputer Terpercaya") @db.VarChar(200)
  whatsappNumber             String   @default("6285769000007") @db.VarChar(30)
  whatsappDefaultTemplate    String   @db.Text
  address                    String   @db.Text
  mapsEmbedUrl               String?  @db.Text
  openHours                  String   @default("Senin - Sabtu: 09.00 - 20.00 WIB") @db.VarChar(200)
  socialInstagram            String?  @db.VarChar(100)
  socialTiktok               String?  @db.VarChar(100)
  socialFacebook             String?  @db.VarChar(100)
  announcementText           String?  @db.VarChar(255)
  isAnnouncementActive       Boolean  @default(false)
  updatedAt                  DateTime @updatedAt

  @@map("store_settings")
}

// ----------------------------------------------------
// 7. TRACKING INTERAKSI & LEAD WHATSAPP
// ----------------------------------------------------
enum InquiryType {
  PRODUCT
  SERVICE
  GENERAL
}

// Portofolio servis: dokumentasi pekerjaan servis yang sudah selesai
model ServiceCase {
  id           String    @id @default(cuid())
  tenantId     String    @db.VarChar(40)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId    String?
  service      Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  title        String    @db.VarChar(150)
  device       String?   @db.VarChar(150)
  summary      String    @db.Text
  durationText String?   @db.VarChar(60)
  completedAt  DateTime?
  // Array URL foto: urutan pertama = foto utama (mis. sebelum), berikutnya sesudah/proses
  images       Json
  isPublished  Boolean   @default(true)
  isSample     Boolean   @default(false)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@index([serviceId])
  @@map("service_cases")
}

enum TestimonialSource {
  GOOGLE
  WHATSAPP
  DIRECT
}

/// Testimoni pelanggan, diinput manual oleh admin toko (tanpa API Google).
model Testimonial {
  id         String            @id @default(cuid())
  tenantId   String            @db.VarChar(40)
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String            @db.VarChar(100)
  descriptor String?           @db.VarChar(120)
  quote      String            @db.VarChar(300)
  rating     Int?              @db.TinyInt
  label      String?           @db.VarChar(80)
  photoUrl   String?           @db.VarChar(255)
  source     TestimonialSource @default(DIRECT)
  // Link ulasan asli: arsip admin, tidak ditampilkan ke pengunjung
  sourceUrl  String?           @db.VarChar(500)
  isActive   Boolean           @default(true)
  isFeatured Boolean           @default(false)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([tenantId, isActive, isFeatured, sortOrder])
  @@map("testimonials")
}

model InquiryLog {
  id             String      @id @default(cuid())
  tenantId       String?     @db.VarChar(40)
  tenant         Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inquiryType    InquiryType @default(PRODUCT)
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceId      String?
  service        Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  variantName    String?     @db.VarChar(100)
  priceAtInquiry BigInt?
  visitorIp      String?     @db.VarChar(50)
  userAgent      String?     @db.VarChar(255)
  referrer       String?     @db.VarChar(255)
  createdAt      DateTime    @default(now())

  @@index([tenantId])
  @@index([inquiryType])
  @@index([productId])
  @@index([serviceId])
  @@index([createdAt])
  @@map("inquiry_logs")
}
