# Optional: set when the prototype has a real preview URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 milik platform RigSpace (founder). Semua storefront tenant dilacak ke
# property ini dengan parameter event "tenant" = slug toko. Kosongkan untuk menonaktifkan.
# Daftarkan "tenant" sebagai Custom dimension (event-scoped) di GA4 agar bisa difilter per toko.
NEXT_PUBLIC_PLATFORM_GA_ID=

# Domain utama platform: rigspace.id = landing, {slug}.rigspace.id = etalase toko
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=rigspace.id
