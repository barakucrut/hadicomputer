# Salin ke .env lalu isi. File .env TIDAK PERNAH di-commit. Panduan produksi: docs/DEPLOYMENT.md

# Database MySQL/MariaDB (main = hadicomputer, branch hadicomputer = hadicomputer_client)
DATABASE_URL=mysql://user:password@localhost:3306/hadicomputer

# Secret sesi — WAJIB diisi di produksi, masing-masing acak >= 32 karakter (openssl rand -base64 48)
ADMIN_JWT_SECRET=
GOD_MODE_JWT_SECRET=
# Mengganti nilai ini = semua link demo lama tidak berlaku
DEMO_LINK_SECRET=

# Superadmin cadangan god-mode (password 8–72 karakter, tidak sama dengan username)
GOD_MODE_USER=
GOD_MODE_PASSWORD=

# URL publik platform (dev: http://localhost:3000, produksi: https://rigspace.id)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 milik platform RigSpace (founder). Semua storefront tenant dilacak ke
# property ini dengan parameter event "tenant" = slug toko. Kosongkan untuk menonaktifkan.
# Daftarkan "tenant" sebagai Custom dimension (event-scoped) di GA4 agar bisa difilter per toko.
NEXT_PUBLIC_PLATFORM_GA_ID=

# Domain utama platform: rigspace.id = landing, {slug}.rigspace.id = etalase toko
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=rigspace.id
